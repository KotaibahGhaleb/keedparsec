<UserControl x:Class="KeedParsecNative.App.Views.HostSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560">
            <TextBlock Text="Host a Session" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock Text="Your room code (share with clients):" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding RoomCode, TargetNullValue='—', FallbackValue='—'}"
                       FontSize="32" FontWeight="Bold" FontFamily="Consolas"
                       Foreground="#FF4FC3F7" Margin="0,0,0,16"/>

            <TextBlock Text="Monitor" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Monitors}" SelectedIndex="{Binding SelectedMonitorIndex}"
                      DisplayMemberPath="DeviceName" Margin="0,4,0,12"/>

            <TextBlock Text="Resolution" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <TextBox Text="{Binding VideoWidth, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <TextBlock Text=" × " VerticalAlignment="Center"/>
                <TextBox Text="{Binding VideoHeight, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            </StackPanel>

            <TextBlock Text="Frame rate (fps)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding VideoFps, UpdateSourceTrigger=PropertyChanged}" Width="70"
                     HorizontalAlignment="Left" Margin="0,4,0,12"/>

            <TextBlock Text="Target bitrate (kbps)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding VideoBitrateKbps, UpdateSourceTrigger=PropertyChanged}" Width="100"
                     HorizontalAlignment="Left" Margin="0,4,0,16"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Start Hosting" Command="{Binding StartHostingCommand}"
                        Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Stop" Command="{Binding StopSessionCommand}"
                        Padding="16,8"/>
            </StackPanel>

            <Border Margin="0,20,0,0" Padding="12" Background="#FFF5F5F5" CornerRadius="6"
                    Visibility="{Binding PendingJoinPeerId, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Join request from "/>
                        <Run Text="{Binding PendingJoinDisplayName}"/>
                    </TextBlock>
                    <TextBlock Text="Allow input:" Margin="0,8,0,0" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="Keyboard" IsChecked="{Binding PendingAllowKeyboard}" Margin="0,0,12,0"/>
                        <CheckBox Content="Mouse" IsChecked="{Binding PendingAllowMouse}" Margin="0,0,12,0"/>
                        <CheckBox Content="Gamepad" IsChecked="{Binding PendingAllowGamepad}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Approve" Command="{Binding ApproveJoinCommand}" Padding="12,4" Margin="0,0,8,0"/>
                        <Button Content="Deny" Command="{Binding DenyJoinCommand}" Padding="12,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Connected players — input permissions" FontWeight="SemiBold" Margin="0,20,0,4"
                       Visibility="{Binding HasPeerPermissions, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding PeerPermissions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="0,2" Background="#FFF5F5F5" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox Content="Keyboard" IsChecked="{Binding AllowKeyboard}" Margin="0,0,10,0"/>
                                    <CheckBox Content="Mouse" IsChecked="{Binding AllowMouse}" Margin="0,0,10,0"/>
                                    <CheckBox Content="Gamepad" IsChecked="{Binding AllowGamepad}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
