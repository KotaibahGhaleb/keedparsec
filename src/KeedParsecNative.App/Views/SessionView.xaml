<UserControl x:Class="KeedParsecNative.App.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1E1E28" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FF9CDCFE"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PipelineStatusText}" Foreground="#FF6A9955"
                           Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" x:Name="VideoSurface" Background="Black"
                Focusable="True"
                MouseMove="Surface_MouseMove"
                MouseDown="Surface_MouseButton"
                MouseUp="Surface_MouseButton"
                MouseWheel="Surface_MouseWheel"
                KeyDown="Surface_Key"
                KeyUp="Surface_Key"
                PreviewMouseDown="Surface_PreviewMouseDown">
            <Grid>
                <Image x:Name="VideoImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
                <TextBlock x:Name="PlaceholderText" Text="No video yet — connect as a client."
                           Foreground="#FF888888" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="16"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
