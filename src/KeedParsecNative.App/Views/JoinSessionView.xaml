<UserControl x:Class="KeedParsecNative.App.Views.JoinSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="480">
        <TextBlock Text="Join a Session" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Your display name" FontWeight="SemiBold"/>
        <TextBox Text="{Binding DisplayNameInput, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4,0,12"/>

        <TextBlock Text="Room code" FontWeight="SemiBold"/>
        <TextBox Text="{Binding JoinRoomCodeInput, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Consolas" FontSize="18" CharacterCasing="Upper"
                 MaxLength="12" Margin="0,4,0,16"/>

        <Button Content="Connect" Command="{Binding ConnectCommand}"
                CommandParameter="{Binding}"
                Padding="16,8" HorizontalAlignment="Left"/>

        <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
