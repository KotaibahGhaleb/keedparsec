{
  "KeedParsec": {
    "Signaling": {
      "BrokerUri": "mqtt://localhost:1883",
      "ClientIdPrefix": "keedparsec"
    },
    "Streaming": {
      "Video": {
        "Codec": "H264",
        "Width": 1920,
        "Height": 1080,
        "FrameRateNumerator": 60,
        "FrameRateDenominator": 1,
        "TargetBitrateKbps": 30000,
        "MaxBitrateKbps": 60000,
        "KeyframeIntervalFrames": 120
      },
      "Audio": {
        "SampleRate": 48000,
        "Channels": 2,
        "BitrateKbps": 256
      },
      "SelectedMonitorIndex": 0,
      "EnableHardwareEncoding": true,
      "EnableHardwareDecoding": true
    },
    "Input": {
      "MousePollRateHz": 120,
      "CaptureKeyboard": true,
      "CaptureMouse": true,
      "CaptureGamepad": true,
      "GamepadPollRateHz": 60,
      "BlockLocalInputWhileStreaming": true
    },
    "Security": {
      "RoomCodeLength": 6,
      "RequireHostApproval": true,
      "JoinTokenTtlSeconds": 60
    },
    "Turn": {
      "Servers": []
    },
    "Diagnostics": {
      "EnableStatsOverlay": true,
      "StatsOverlayIntervalMs": 1000,
      "LogToFile": true,
      "LogDirectory": "logs"
    }
  }
}
